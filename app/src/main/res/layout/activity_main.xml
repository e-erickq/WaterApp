<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Nosso componente customizado -->
    <com.example.waterapp.view.WaterProgressView
        android:id="@+id/waterProgress"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center_horizontal"
        app:maxValue="2000"
        app:progressColor="#2196F3"
        app:textColor="#000000" />

    <!-- Alerta da tela: fica escondido até a meta ser ultrapassada -->
    <TextView
        android:id="@+id/tvAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E53935"
        android:gravity="center"
        android:padding="8dp"
        android:text="Meta diária ultrapassada!"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center" />

    <!-- Registrar consumo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etVolume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Volume (ml)"
            android:inputType="number"
            android:maxLength="5" />

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar" />
    </LinearLayout>

    <!-- Alterar meta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etGoal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Nova meta (ml)"
            android:inputType="number"
            android:maxLength="5" />

        <Button
            android:id="@+id/btnGoal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alterar meta" />
    </LinearLayout>

    <!-- Lista dos registros do dia -->
    <ListView
        android:id="@+id/lvRecords"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />
</LinearLayout>